# Environment Variables
# Copy this file to .env.local and fill in your values

# Google Gemini API Key (required)
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: pin a model. If unset (or retired) the app tries gemini-3.6-flash, gemini-3.8-flash, gemini-2.5-flash in turn.
# GEMINI_MODEL=gemini-3.6-flash

# Set to your deployed URL (no trailing slash) so link previews work, e.g. https://your-app.vercel.app
# NEXT_PUBLIC_SITE_URL=
